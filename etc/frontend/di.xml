<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd"
>
    <type name="Hyva\CompatModuleFallback\Model\CompatModuleRegistry">
        <arguments>
            <argument name="compatModules" xsi:type="array">
                <item name="hyva-magento2-checkout-euplatesc" xsi:type="array">
                    <item name="original_module" xsi:type="string">EuroPayment_EuPlatesc</item>
                    <item name="compat_module" xsi:type="string">Liquidlab_HyvaEuPlatesc</item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Hyva\Checkout\Model\Magewire\Payment\PlaceOrderServiceProvider">
        <arguments>
            <argument name="placeOrderServiceList" xsi:type="array">
                <item name="eppay" xsi:type="object">Liquidlab\HyvaEuPlatesc\Magewire\Checkout\Payment\EuPlatescPlaceOrderService</item>
            </argument>
        </arguments>
    </type>

    <type name="Hyva\Checkout\Magewire\Checkout\Payment\MethodList">
        <plugin name="liquidlab_hyva_euplatesc_method_list"
                type="Liquidlab\HyvaEuPlatesc\Plugin\Magewire\Checkout\Payment\MethodListPlugin" />
    </type>
</config>